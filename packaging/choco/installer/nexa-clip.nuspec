    <id>nexa-clip</id>
    <version>@VERSION@</version>
    <packageSourceUrl>https://github.com/SosomLab/nexa-clip/tree/main/packaging/choco/installer</packageSourceUrl>
    <owners>SosomLab</owners>
    <title>Nexa Clip</title>
    <authors>Sangyong Bae</authors>
    <copyright>Copyright (c) 2026 SosomLab - Nexa Clip</copyright>
    <projectUrl>https://github.com/SosomLab/nexa-clip</projectUrl>
    <iconUrl>https://cdn.jsdelivr.net/gh/SosomLab/nexa-clip@v@VERSION@/packaging/branding/nexa-clip-256.png</iconUrl>
    <licenseUrl>https://github.com/SosomLab/nexa-clip/blob/main/LICENSE.md</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/SosomLab/nexa-clip</projectSourceUrl>
